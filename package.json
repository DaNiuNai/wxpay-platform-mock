{
  "name": "wxpay-platform-mock",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-web.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.*",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "keys:export": "tsx scripts/export-keys.ts",
    "smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
